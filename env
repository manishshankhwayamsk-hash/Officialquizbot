# Copy this file to .env for local testing (python-dotenv loads it automatically).
# On Render, do NOT upload a .env file — set these same keys under
# Dashboard → your service → Environment instead. Never commit a real .env file.

# ── Required ──────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram after creating your bot.
BOT_TOKEN=8979014886:AAFQ4ifw-MwycjELQcZEnaub-90v4xkdPTM
# Your numeric Telegram user ID (get it from @userinfobot). This account gets
# every owner-only command: /broadcast, /granttop10, /quizblast, /backupnow, etc.
OWNER_ID=8970933948

# ── Database ──────────────────────────────────────────────────────────────
# Leave empty to use local SQLite (fine for quick local testing — NOT safe on
# Render, whose disk is wiped on every redeploy). Set this to a Postgres
# connection string for anything real; Render's Blueprint (render.yaml) wires
# this automatically if you deploy through it.
DATABASE_URL=

# Only used for the local-SQLite fallback above; ignored once DATABASE_URL is set.
DB_NAME=quiz_bot.db

# ── AI quiz generation ───────────────────────────────────────────────────
# Optional shared key so /topic, /pdf etc. work even for users who haven't
# added their own key with /addapi. Leave blank to require everyone to /addapi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ── Required-join gate (optional) ────────────────────────────────────────
# If set, users must join this channel/group before using the bot (checked via
# "✅ I Am Verified"). Leave as-is / blank to skip the gate entirely.
UPDATE_CHANNEL=@rajasthani_mannu 
UPDATE_GROUP=@NEET_NURSING_CNET_GROUP

# ── Platform-provided (usually leave alone) ─────────────────────────────
# Render sets PORT itself; only needed for the keep-alive health-check server.
PORT=10000
